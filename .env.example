# .env.example — plantilla de variables de entorno de El Playbook NFL.
#
# Copia este archivo a ".env" y rellena solo lo que vayas a usar. La app
# arranca y funciona perfectamente sin ningun .env: todas estas variables
# son opcionales y activan integraciones externas que hoy estan apagadas.
#
# NUNCA subas un .env real (con valores reales) al repositorio — ya esta
# incluido en .gitignore.

# Entorno de ejecucion (solo informativo por ahora: "development" | "production")
APP_ENV=development

# Dominio publico del sitio, usado en las paginas legales y en los metadatos.
SITE_URL=https://elplaybooknfl.com

# Email de contacto mostrado en Contacto/Aviso legal/Privacidad.
CONTACT_EMAIL=elplaybooknfl@gmail.com

# --- Google Analytics (GA4) ---
# ID de medicion (formato "G-XXXXXXXXXX", el que te da GA4 al crear el flujo de
# datos web). Vacio = no se carga ningun script de analytics ni se manda ningun
# evento — la app funciona exactamente igual con o sin esto configurado.
#
# Ver DEPLOY.md ("Analytics (Google Analytics 4)") para como configurarlo en
# local/Cloud Run, la lista de eventos que se mandan (components/tracking.py) y
# el aviso importante sobre consentimiento de cookies antes de activar esto en
# produccion con trafico real de la UE.
GOOGLE_ANALYTICS_ID=

# --- Google Search Console ---
# Codigo del meta tag de verificacion de propiedad (solo el valor "content",
# no la etiqueta <meta> completa). Vacio = no se inyecta nada.
GOOGLE_SITE_VERIFICATION=

# --- Google AdSense ---
# Publisher ID (formato "pub-XXXXXXXXXXXXXXXX"). Vacio = AdSense
# permanece completamente desactivado: no se carga ningun script ni se
# reserva ningun hueco publicitario. No implementes anuncios reales ni
# rellenes esto con un ID inventado — solo con el ID real cuando el sitio
# este listo para solicitar/activar AdSense.
GOOGLE_ADSENSE_PUBLISHER_ID=
